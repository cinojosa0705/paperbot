# paperbot — copy to ~/.paperbot/env, fill in, then `source ~/.paperbot/env`. Never commit the filled copy.
export PAPERBOT_STATE=$HOME/.paperbot/state.json     # session key + nonce + in-flight pair (written by `register`)
export PAPERBOT_LEDGER=$HOME/.paperbot/ledger.jsonl  # one JSON line per cycle
export PAPERBOT_TG_TOKEN=                            # @BotFather token (optional: no Telegram without it)
export PAPERBOT_TG_CHAT=                             # your group id, e.g. -100123456789
export PAPERBOT_TG_USERS=                            # comma-separated user ids allowed to issue commands (unset = anyone in the group)
export PAPERBOT_RPC=https://rpc.hyperliquid.xyz/evm  # HyperEVM JSON-RPC; the public node rate-limits log scans, an Alchemy key is better
export PAPERBOT_RPC_LOG_RANGE=1000                   # blocks per eth_getLogs: 10 on Alchemy free tier, 1000 on the public node
